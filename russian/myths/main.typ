= Мифологемы

#let idiom(title, meaning, origin) = [
  + *#title* \
    _Значение_: #meaning \
    _Происхождение_: #origin \
]

#idiom(
  [Ахиллесова пята],
  [Уязвимое место или слабость человека, в остальном сильного и непобедимого.],
  [Мать Ахилла, богиня Фетида, окунула его в священные воды реки Стикс, держа за пятку. Пята осталась единственным незащищенным местом, куда его и поразил стрелой Парис.],
)

#idiom(
  [Ящик Пандоры],
  [Источник многочисленных бед, несчастий и неприятностей, открытый по неосторожности.],
  [Зевс отправил на Землю первую женщину Пандору с сосудом (впоследствии названным ящиком), запретив его открывать. Из любопытства Пандора открыла крышку, выпустив на свободу все человеческие пороки и болезни.],
)

#idiom(
  [Троянский конь],
  [Тайный, коварный замысел; подарок с вредоносным подвохом.],
  [Греки построили огромного деревянного коня, спрятав внутри воинов, и оставили у стен Трои под видом дара. Троянцы затащили коня в город, а ночью греческие воины вылезли и открыли ворота своей армии.],
)

#idiom(
  [Авгиевы конюшни],
  [Крайняя запущенность, беспорядок или загрязнение, требующие огромных усилий для уборки.],
  [Царь Авгий годами не чистил свои огромные скотные дворы. Геракл очистил их за один день, направив в конюшни русла двух бурлящих рек --- Альфея и Пенея.],
)

#idiom(
  [Сизифов труд],
  [Бесконечная, тяжелая и совершенно безрезультатная работа.],
  [За обман богов царь Сизиф был наказан в Аиде: он вечно катит на вершину горы тяжелый камень, который перед самым пиком срывается и падает вниз.],
)

#idiom(
  [Нить Ариадны],
  [Способ или путеводная нить, помогающая найти выход из сложной ситуации.],
  [Ариадна дала царевичу Тесею клубок ниток, когда тот отправился в Критский лабиринт убивать Минотавра. Разматывая нить, Тесей смог благополучно найти дорогу назад.],
)

#idiom(
  [Дамоклов меч],
  [Постоянно нависшая, близкая и грозная опасность при видимом благополучии.],
  [Сиракузский тиран Дионисий посадил на свой престол льстеца Дамокла, но повесил над его головой острый меч на конском волосе, покажав, насколько хрупка и опасна власть.],
)

#idiom(
  [Яблоко раздора],
  [Причина споров, вражды и серьезных разногласий.],
  [Богиня раздора Эрида подбросила на пир яблоко с надписью "Прекраснейшей". За него заспорили Гера, Афина и Афродита, что в итоге привело к Троянской войне.],
)

#idiom(
  [Прокрустово ложе],
  [Искусственная мерка или формальные рамки, под которые насильственно подгоняют явления.],
  [Разбойник Прокруст укладывал путников на свое ложе: тем, кто был длиннее, он обрубал ноги, а коротких --- вытягивал, пока они не подходили под размер кровати.],
)

#idiom(
  [Кануть в Лету],
  [Навсегда исчезнуть, бесследно уйти в прошлое или быть преданным забытью.],
  [Лета --- река забвения в подземном царстве Аида. Души умерших, испившие из нее воды, забывали всю свою земную жизнь.],
)

#signature
